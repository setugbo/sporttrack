# ---------------------------------------------------------------------------
# Virtual Football Match Tracker - environment
# Copy to `.env.local` for local dev (git-ignored) or paste into your host's
# environment-variable UI (Vercel / cPanel).
# ---------------------------------------------------------------------------

# REQUIRED. PostgreSQL connection string.
#   Neon:     postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres.PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
#   Local:    postgresql://postgres:postgres@localhost:5432/vftracker
DATABASE_URL=

# Optional. Defaults shown.
# Initial source URL registered by `npm run db:seed`.
DEFAULT_SOURCE_URL=https://www.sportybet.com/ng/m/sport/vFootball/live_list

# Poll cadence for tracking sessions, in seconds (10 - 300).
# 30 is the recommended default: SportyBet drops a finished vFootball match from
# its feed roughly 24s after the match clock reaches 89:00, so a 60s interval can
# miss the last sample. See docs/sportybet-integration.md section 5.
DEFAULT_POLL_INTERVAL=30

# Upstream request timeout, milliseconds.
UPSTREAM_TIMEOUT_MS=15000

# Shared secret required by GET/POST /api/cron/poll (Vercel Cron sends this as
# the `Authorization: Bearer <value>` header). Leave empty to disable the cron
# endpoint's auth requirement.
CRON_SECRET=

# Set to "1" to disable the debug/raw-data screen entirely.
DISABLE_DEBUG_SCREEN=