{
    "name": "virtual-football-match-tracker",
    "version": "1.0.0",
    "private": true,
    "description": "Lightweight tracker that collects SportyBet Nigeria Virtual Football live scores and builds its own historical results database for manual study.",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mjs",
        "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mjs",
        "db:seed": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-source.mts",
        "poll:once": "node --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/poll-once.mts"
    },
    "dependencies": {
        "next": "15.5.27",
        "postgres": "3.4.5",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "server-only": "0.0.1",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@types/node": "22.15.3",
        "@types/react": "19.1.8",
        "@types/react-dom": "19.1.6",
        "eslint": "8.57.1",
        "eslint-config-next": "15.5.27",
        "typescript": "5.8.3",
        "vitest": "2.1.9"
    },
    "overrides": {
        "postcss": "8.5.29"
    }
}
